{
  "keynote": {
    "name": "Keynote",
    "line": "Apple-style product film: huge type, one accent, 3D devices with glass sweeps, a feature wall on the drop.",
    "useFor": "product launches, new versions, hardware-feeling apps, anything that wants to feel premium and confident",
    "bpm": [
      115,
      128
    ],
    "music": "electronic or indie pop with a clear build, a short gap and a drop; no vocals",
    "mixkit": [
      "electronic",
      "tag/uplifting",
      "tag/motivational",
      "instrument/synth",
      "tag/corporate"
    ],
    "fonts": {
      "display": "Instrument Serif:ital@0;1",
      "body": "Figtree:wght@400..800"
    },
    "displayItalicAccent": true,
