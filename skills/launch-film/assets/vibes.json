        "ink": "#1d1d1f",
        "sub": "#6e6e73",
        "acc": "#0071e3",
        "accHi": "#4aa3ff"
      }
    },
    "motion": {
      "spring": "type",
      "stagger": 0.06,
      "rise": 1.15,
      "rot": 3,
      "devices": "3d",
      "transition": "rise"
